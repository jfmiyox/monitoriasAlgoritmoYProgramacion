% ============================================================================
% Macros y entorno de Tabla de Traduccion (DFD <-> PSeInt <-> C++)
% ============================================================================
\NewDocumentEnvironment{tablatraduccion}{ O{Tabla de Traducción: DFD $\leftrightarrow$ PSeInt $\leftrightarrow$ C++} +b }{%
  \par\addvspace{6pt}
  \begin{center}
    \small
    \captionof{table}{#1}
    \renewcommand{\arraystretch}{1.35}
    \rowcolors{2}{GrisSuave}{white}
    \begin{tabularx}{\linewidth}{>{\leavevmode\bfseries\sffamily\color{AzulMarino}\raggedright\arraybackslash}p{3.2cm} >{\leavevmode\raggedright\arraybackslash}p{3.1cm} >{\leavevmode\ttfamily\footnotesize\raggedright\arraybackslash}X >{\leavevmode\ttfamily\footnotesize\raggedright\arraybackslash}X}
      \rowcolor{AzulMarino}
      \textcolor{white}{\textbf{Concepto}} &
      \textcolor{white}{\textbf{Símbolo DFD}} &
      \textcolor{white}{\textbf{\sffamily PSeInt}} &
      \textcolor{white}{\textbf{\sffamily C++ básico}} \\
      #2
    \bottomrule
    \end{tabularx}
  \end{center}
  \par\addvspace{6pt}
}{}

\newcommand{\tablatraducciongeneral}{%
  \begin{tablatraduccion}[Tabla Maestra de Traducción: DFD $\leftrightarrow$ PSeInt $\leftrightarrow$ C++ Básico]
    Inicio / Fin & Óvalo (Inicio / Fin) & Algoritmo Nombre \dots\ FinAlgoritmo & int main() \{ \dots\ return 0; \} \\
    Declarar variable & No obligatorio (implícito) & Definir x Como Entero; & int x; \\
    Leer dato & Paralelogramo / Trapecio & Leer x; & cin >> x; \\
    Mostrar pantalla & Cono / Documento salida & Escribir "Hola ", x; & cout << "Hola " << x << endl; \\
    Asignación & Rectángulo (Proceso) & x <- a + b; & x = a + b; \\
    Condicional doble & Rombo (Sí / No) & Si c Entonces \dots\ SiNo \dots\ FinSi & if (c) \{ \dots\ \} else \{ \dots\ \} \\
    Selección múltiple & Rombo encadenado & Segun op Hacer 1: \dots\ FinSegun & switch(op) \{ case 1: \dots\ break; \} \\
    Ciclo Mientras & Hexágono / Rombo ciclo & Mientras c Hacer \dots\ FinMientras & while (c) \{ \dots\ \} \\
    Ciclo Hasta / Do-While & Condición al final & Repetir \dots\ Hasta Que (fin!) & do \{ \dots\ \} while (sigue!); \\
    Ciclo Para & Hexágono contador & Para i <- 0 Hasta n-1 Hacer & for (int i = 0; i < n; i++) \\
    Vector estático & Proceso + índice & Dimension v[100]; (base 1 ó 0) & const int MAX=100; int v[MAX]; \\
    Matriz estática & Doble ciclo [i][j] & Dimension m[10,10]; & int m[10][10]; \\
  \end{tablatraduccion}
}

