% \portadamodulo{num}{titulo}{horas}{subtitulo}{objetivos}
\newcommand{\portadamodulo}[5]{%
  \renewcommand{\monitoria@headerleft}{Módulo #1: #2}%
  \renewcommand{\monitoria@headerright}{Duración: #3}%
  \thispagestyle{plain}%
  \begin{tcolorbox}[
    enhanced,
    colback=AzulMarino,
    colframe=AzulMarino,
    arc=5pt,
    top=6mm,
    bottom=6mm,
    left=6mm,
    right=6mm,
    boxrule=0pt
  ]
    {\small\sffamily\bfseries\color{Turquesa!40!white}
      CURSO DE MONITORÍA $\bullet$ ALGORITMOS Y PROGRAMACIÓN (30 HORAS)}\\[6pt]
    \tcbox[on line,colback=Turquesa,colframe=Turquesa,arc=3pt,boxsep=2pt,left=5pt,right=5pt,top=2pt,bottom=2pt]{%
      \small\sffamily\bfseries\color{white} MÓDULO #1%
    }\hspace{6pt}%
    \tcbox[on line,colback=NaranjaCalido,colframe=NaranjaCalido,arc=3pt,boxsep=2pt,left=5pt,right=5pt,top=2pt,bottom=2pt]{%
      \small\sffamily\bfseries\color{white} \faClock\hspace{3pt} #3%
    }\\[8pt]
    {\LARGE\bfseries\sffamily\color{white}#2}\\[5pt]
    {\normalsize\sffamily\color{AzulSuave}#4}
  \end{tcolorbox}
  \vspace{2pt}
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=GrisSuave,
    colframe=Turquesa,
    leftrule=3.5pt,
    boxrule=0.7pt,
    arc=3pt,
    top=3mm,
    bottom=3mm,
    left=4mm,
    right=4mm,
    fonttitle=\bfseries\sffamily\color{AzulMarino},
    colbacktitle=TurquesaClaro,
    title={\faBullseye\hspace{0.5em}Objetivos de Aprendizaje del Módulo}
  ]
    #5
  \end{tcolorbox}
  \vspace{6pt}
}

