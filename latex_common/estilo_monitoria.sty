% ============================================================================
% Estilo de secciones
% ============================================================================
\RequirePackage{titlesec}
\titleformat{\section}
  {\Large\bfseries\sffamily\color{AzulMarino}}
  {\colorbox{AzulMarino}{\color{white}\makebox[1.6em]{\thesection}}\hspace{0.55em}}
  {0pt}
  {}
  [\vspace{2pt}{\color{Turquesa}\titlerule[1.2pt]}]

\titleformat{name=\section,numberless}
  {\Large\bfseries\sffamily\color{AzulMarino}}
  {}
  {0pt}
  {}
  [\vspace{2pt}{\color{Turquesa}\titlerule[1.2pt]}]

\titleformat{\subsection}
  {\large\bfseries\sffamily\color{Turquesa}}
  {\thesubsection\hspace{0.5em}}
  {0pt}
  {}

\titleformat{\subsubsection}
  {\normalsize\bfseries\sffamily\color{AzulMarino}}
  {\thesubsubsection\hspace{0.5em}}
  {0pt}
  {}

\titlespacing*{\section}{0pt}{14pt plus 3pt minus 2pt}{8pt plus 2pt}
\titlespacing*{\subsection}{0pt}{11pt plus 2pt minus 1pt}{5pt plus 1pt}
