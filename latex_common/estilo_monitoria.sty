% ============================================================================
% Configuracion de listings: UTF-8 para XeLaTeX + C++ + PSeInt
% ============================================================================
\RequirePackage{listings}
\AtBeginDocument{%
  \renewcommand{\lstlistingname}{Código}%
  \renewcommand{\lstlistlistingname}{Índice de códigos}%
}

\lstdefinelanguage{PSeInt}{
  morekeywords=[1]{
    Algoritmo, FinAlgoritmo, Proceso, FinProceso,
    Definir, Como, Dimension,
    Escribir, Imprimir, Leer,
    Si, Entonces, SiNo, Sino, FinSi,
    Segun, De, Otro, Modo, Hacer, FinSegun,
    Mientras, FinMientras,
    Repetir, Hasta, Que,
    Para, Con, Paso, FinPara,
    Funcion, FinFuncion, SubProceso, FinSubProceso
  },
  morekeywords=[2]{
    Entero, Real, Caracter, Logico, Cadena,
    Verdadero, Falso, Y, O, NO, MOD
  },
  sensitive=false,
  morecomment=[l]{//},
  morestring=[b]",
  morestring=[b]'
}

\lstdefinestyle{monitoriaBaseCode}{
  basicstyle=\ttfamily\footnotesize\color{AzulMarino!90!black},
  backgroundcolor=\color{GrisSuave},
  frame=single,
  rulecolor=\color{GrisBorde},
  frameround=tttt,
  framesep=5pt,
  xleftmargin=16pt,
  xrightmargin=4pt,
  numbers=left,
  numberstyle=\tiny\sffamily\color{ComentarioCodigo},
  numbersep=8pt,
  tabsize=4,
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=false,
  keepspaces=true,
  columns=fixed,
  basewidth=0.52em,
  extendedchars=true,
  aboveskip=8pt,
  belowskip=8pt,
  captionpos=b,
  commentstyle=\itshape\color{ComentarioCodigo},
  stringstyle=\color{NaranjaCalido!90!black},
  literate=
    {á}{{á}}1 {é}{{é}}1 {í}{{í}}1 {ó}{{ó}}1 {ú}{{ú}}1
    {Á}{{Á}}1 {É}{{É}}1 {Í}{{Í}}1 {Ó}{{Ó}}1 {Ú}{{Ú}}1
    {ñ}{{ñ}}1 {Ñ}{{Ñ}}1 {ü}{{ü}}1 {Ü}{{Ü}}1
    {¿}{{¿}}1 {¡}{{¡}}1
    {←}{{$\leftarrow$}}1 {≤}{{$\le$}}1 {≥}{{$\ge$}}1 {≠}{{$\neq$}}1
    {°}{{°}}1
}

\lstdefinestyle{cppmonitoria}{
  language=C++,
  style=monitoriaBaseCode,
  keywordstyle=\bfseries\color{AzulMarino},
  keywordstyle=[2]\bfseries\color{Turquesa},
  morekeywords=[2]{int,float,double,char,bool,void,string,const,true,false,
                   cin,cout,endl,getline,ignore,size_t},
  emph={include,define,iostream,iomanip,cmath,string,using,namespace,std},
  emphstyle=\bfseries\color{MoradoAcento}
}

\lstdefinestyle{pseintmonitoria}{
  language=PSeInt,
  style=monitoriaBaseCode,
  keywordstyle=[1]\bfseries\color{AzulMarino},
  keywordstyle=[2]\bfseries\color{Turquesa}
}

